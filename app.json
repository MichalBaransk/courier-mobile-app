{
  "expo": {
    "name": "courier-app",
    "slug": "courier-app",
    "scheme": "courierapp",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.michalbaranski.courierapp",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aplikacja używa lokalizacji, żeby policzyć dojazd do restauracji od Twojej BIEŻĄCEJ pozycji, a nie od ostatniego ręcznie wysłanego punktu.",
          "locationAlwaysAndWhenInUsePermission": "Lokalizacja w tle pozwala liczyć dojazd również wtedy, gdy aplikacja jest zminimalizowana podczas kursu.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dostęp do zdjęć pozwala dodać paragon paliwowy albo zrzut oferty prosto z galerii.",
          "cameraPermission": "Aparat pozwala sfotografować paragon paliwowy bez zapisywania go w galerii."
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Mikrofon pozwala dyktować wpisy zamiast je wystukiwać — przydatne w rękawicach i w ruchu."
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*"
          ]
        }
      ],
      "expo-audio",
      "expo-background-task",
      "expo-sharing",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "215161ac-d885-4d01-8b9b-8f29cb1db07f"
      }
    },
    "owner": "michalbaranski",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/215161ac-d885-4d01-8b9b-8f29cb1db07f"
    }
  }
}
